# URL publique de l'application (utilisée dans les emails et le QR code)
APP_URL=https://avent.example.com
# Secret (32+ caractères) pour signer les cookies et chiffrer les mots de passe SMTP/PostgreSQL.
# Laissez vide pour qu'il soit généré automatiquement dans le volume /app/data.
APP_SECRET=
# Création automatique du premier administrateur (sinon : assistant /setup au premier lancement)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Port exposé sur l'hôte
PORT=3000
# Mettre true derrière un reverse proxy HTTPS (Traefik, Nginx Proxy Manager…)
COOKIE_SECURE=false
# Lire l'IP réelle depuis X-Forwarded-For (nécessaire derrière un proxy pour l'anti-force brute)
TRUST_PROXY=true
TZ=Europe/Paris
# Image pré-construite (GitHub Container Registry) au lieu d'un build local
# IMAGE=ghcr.io/<utilisateur>/<depot>:latest
# PostgreSQL (docker-compose.postgres.yml)
POSTGRES_USER=advent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=advent
